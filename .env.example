# Copy this file to .env.local for local development, and add the same
# variables in Vercel > Project > Settings > Environment Variables.
# Students never see any of these values.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "service_role" secret key. Server only. Never share it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta for Developers (App settings > Basic) ---
META_APP_ID=
META_APP_SECRET=
# Optional. Only if Facebook Login for Business asks you to use a "configuration":
# paste the Configuration ID here and the app sends it instead of a scope list.
META_LOGIN_CONFIG_ID=
# Optional. Graph API version to call. Defaults to v21.0.
META_GRAPH_VERSION=

# --- Direct Instagram sign-in (recommended; no Facebook Page needed) ---
# Meta > your app > Instagram > "API setup with Instagram login". These are NOT the same as
# META_APP_ID / META_APP_SECRET. When both are set, students see "Continue with Instagram".
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- This app ---
# The public address of the app, with no slash at the end.
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Any long random text. Protects /api/cron/publish.
CRON_SECRET=

# --- Optional: AI caption helper (Google Gemini) ---
# Leave empty to hide the "Write with AI" button.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
